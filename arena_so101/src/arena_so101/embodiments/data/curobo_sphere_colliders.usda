def Xform "World"
{
    def "SO_ARM101_USD" (
        prepend references = @./SO-ARM101-USD.usd@
    )
    {
        over "jaw"
        {
            token visibility = "inherited"

            def Sphere "curobo_collider_sphere"
            {
                float3[] extent = [(-0.004, -0.004, -0.004), (0.004, 0.004, 0.004)]
                double radius = 0.004
                custom bool refinementEnableOverride = 1
                custom int refinementLevel = 2
                quatd xformOp:orient = (1, 0, 0, 0)
                double3 xformOp:scale = (1, 1, 1)
                double3 xformOp:translate = (-0.009143070959983346, -0.07709503554006031, 0.019116056965293036)
